# Copy to deploy/.env.production on the server and fill it in.
# NEVER commit deploy/.env.production (it is in .gitignore).

APP_NAME=Choronai
APP_ENV=production
APP_DEBUG=false
# Create with: docker compose -f deploy/compose.prod.yaml --env-file deploy/.env.production run --rm api php artisan key:generate --show
APP_KEY=
APP_URL=http://52.220.42.228
# The address people open (IP now, your domain later).
FRONTEND_URL=http://52.220.42.228
# Caddy: ":80" for the IP only, or "pos.example.com" for automatic HTTPS.
SITE_ADDRESS=:80

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=choronai
DB_USERNAME=choronai
# A long random password (e.g. `openssl rand -hex 24`).
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
BCRYPT_ROUNDS=12

# Cloudflare R2 for product photos (same bucket as development is fine).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=choronai-pos
R2_ENDPOINT=https://8815e396c30b4c3ab79299379b7e555d.r2.cloudflarestorage.com
R2_PUBLIC_URL=
